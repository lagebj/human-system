{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:27b",
  "autoupdate": false,
  "instructions": [
    "/home/node/.config/opencode/instructions/human-system-agent-skills.md"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "~/.local/share/human-system-agent-skills/**": "allow"
    },
    "edit": {
      "~/.local/share/human-system-agent-skills/**": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      }
    },
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1/",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "glm-5.1:cloud": {
          "name": "Ollama Cloud · GLM-5.1",
          "limit": {
            "context": 202752,
            "output": 32768
          }
        }
      }
    }
  }
}