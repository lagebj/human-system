# Human System — local devcontainer secrets
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# The devcontainer loads `.env` automatically on boot: values fill in any
# environment variables not already set (Codespaces secrets and containerEnv
# take precedence over .env values). See .devcontainer/README.md.
#
# In GitHub Codespaces, set these as Codespaces secrets instead; `.env` is
# never present there and the auto-loader skips entirely.

# OpenCode Web / OpenCode CLI model access.
OLLAMA_API_KEY=

# GitHub CLI + git auth (used by `gh`, and by the skill sync when it needs to
# reach private repositories). A fine-grained or classic PAT.
GH_TOKEN=

# Claude Code subscription auth token (optional; `claude` can also log in
# interactively).
CLAUDE_CODE_OAUTH_TOKEN=
