# Human System — local devcontainer secrets
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# The devcontainer loads `.env` automatically on boot: values are exported
# into every terminal, the VS Code environment probe, and the lifecycle
# scripts. See .devcontainer/README.md.
#
# In GitHub Codespaces, set these as Codespaces secrets instead; `.env` is
# never present there and the auto-loader is a no-op.

# OpenCode Web / OpenCode CLI model access.
OLLAMA_API_KEY=

# GitHub CLI + git auth (used by `gh`, and by the skill sync when it needs to
# reach private repositories). A fine-grained or classic PAT.
GH_TOKEN=

# Claude Code subscription auth token (optional; `claude` can also log in
# interactively).
CLAUDE_CODE_OAUTH_TOKEN=
