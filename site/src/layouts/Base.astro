---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = '' } = Astro.props;
const canonicalURL = Astro.props.canonical 
  ? new URL(Astro.props.canonical, Astro.site)
  : Astro.url;

// Base path for GitHub Pages project site
const basePath = '/human-system';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Human System" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <title>{title} | Human System</title>
    
    <!-- Preload critical fonts if using web fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <style>
      /* CSS Reset and base styles */
      *, *::before, *::after {
        box-sizing: border-box;
      }
      
      html {
        font-size: 100%;
        -webkit-text-size-adjust: 100%;
        -moz-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
      
      body {
        margin: 0;
        padding: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        font-size: 1.125rem;
        line-height: 1.75;
        color: #1a1a1a;
        background-color: #fafafa;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      /* Typography */
      h1, h2, h3, h4, h5, h6 {
        font-weight: 600;
        line-height: 1.3;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: #0a0a0a;
      }
      
      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-top: 0;
      }
      
      h2 {
        font-size: 2rem;
        border-bottom: 1px solid #e5e5e5;
        padding-bottom: 0.5rem;
      }
      
      h3 {
        font-size: 1.5rem;
      }
      
      h4 {
        font-size: 1.25rem;
      }
      
      p {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        max-width: 65ch;
      }
      
      ul, ol {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        padding-left: 2rem;
      }
      
      li {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
      }
      
      a {
        color: #2563eb;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      
      a:hover {
        color: #1d4ed8;
      }
      
      a:focus {
        outline: 2px solid #2563eb;
        outline-offset: 2px;
        border-radius: 2px;
      }
      
      blockquote {
        margin: 2rem 0;
        padding: 1rem 1.5rem;
        border-left: 4px solid #e5e5e5;
        background-color: #f5f5f5;
        font-style: italic;
      }
      
      blockquote p {
        margin: 0;
      }
      
      code {
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
        font-size: 0.875em;
        background-color: #f5f5f5;
        padding: 0.2em 0.4em;
        border-radius: 3px;
      }
      
      pre {
        margin: 2rem 0;
        padding: 1.5rem;
        background-color: #1a1a1a;
        color: #f5f5f5;
        border-radius: 6px;
        overflow-x: auto;
      }
      
      pre code {
        background: none;
        padding: 0;
        color: inherit;
      }
      
      hr {
        border: none;
        border-top: 1px solid #e5e5e5;
        margin: 3rem 0;
      }
      
      /* Layout */
      .container {
        max-width: 80rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      
      .prose {
        max-width: 65ch;
      }
      
      /* Header */
      .site-header {
        padding: 2rem 0;
        border-bottom: 1px solid #e5e5e5;
        background-color: #fafafa;
      }
      
      .site-header a {
        text-decoration: none;
        color: #1a1a1a;
      }
      
      .site-header a:hover {
        color: #2563eb;
      }
      
      .site-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
      }
      
      .site-nav {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
      }
      
      .site-nav a {
        font-size: 0.875rem;
        color: #555;
      }
      
      .site-nav a:hover {
        color: #2563eb;
      }
      
      /* Main content */
      .site-main {
        padding: 3rem 0;
        min-height: calc(100vh - 300px);
      }
      
      /* Footer */
      .site-footer {
        padding: 2rem 0;
        border-top: 1px solid #e5e5e5;
        background-color: #fafafa;
        font-size: 0.875rem;
        color: #555;
      }
      
      .site-footer a {
        color: #555;
      }
      
      .site-footer a:hover {
        color: #2563eb;
      }
      
      /* Paper list */
      .paper-list {
        list-style: none;
        padding: 0;
      }
      
      .paper-item {
        padding: 1.5rem 0;
        border-bottom: 1px solid #e5e5e5;
      }
      
      .paper-item:last-child {
        border-bottom: none;
      }
      
      .paper-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
      }
      
      .paper-title a {
        text-decoration: none;
      }
      
      .paper-title a:hover {
        text-decoration: underline;
      }
      
      .paper-description {
        color: #555;
        margin: 0.5rem 0;
      }
      
      .paper-meta {
        font-size: 0.875rem;
        color: #777;
      }
      
      /* Paper page */
      .paper-header {
        margin-bottom: 3rem;
      }
      
      .paper-meta-block {
        font-size: 0.875rem;
        color: #777;
        margin-top: 1rem;
      }
      
      /* Empty state */
      .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #555;
      }
      
      .empty-state p {
        max-width: none;
      }
      
      /* Responsive */
      @media (max-width: 768px) {
        html {
          font-size: 100%;
        }
        
        h1 {
          font-size: 2rem;
        }
        
        h2 {
          font-size: 1.5rem;
        }
        
        .site-nav {
          flex-wrap: wrap;
          gap: 1rem;
        }
        
        .container {
          padding: 0 1rem;
        }
      }
      
      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
      
      /* Print styles */
      @media print {
        .site-header, .site-footer, .site-nav {
          display: none;
        }
        
        body {
          background: white;
          color: black;
        }
        
        a {
          text-decoration: underline;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={basePath} class="site-title">Human System</a>
        <nav class="site-nav">
          <a href={`${basePath}/`}>Home</a>
          <a href={`${basePath}/papers/`}>Papers</a>
          <a href={`${basePath}/about/`}>About</a>
        </nav>
      </div>
    </header>
    
    <main class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>
    
    <footer class="site-footer">
      <div class="container">
        <p>
          <a href="https://github.com/lagebj/human-system">Source</a> ·
          <a href="https://github.com/lagebj/human-system/blob/main/LICENSE.md">License</a> ·
          <a href={`${basePath}/about/`}>About</a>
        </p>
        <p>
          Published material licensed under 
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC-BY-NC-SA-4.0</a>.
          Tooling licensed under <a href="https://mozilla.org/MPL/2.0/">MPL-2.0</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
